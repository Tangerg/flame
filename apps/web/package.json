{
  "name": "@flame/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.22.0 || >=26.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src lab scripts --deny-warnings",
    "lint:fix": "oxlint src --fix --deny-warnings",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check:circular": "node scripts/check-circular.mjs",
    "check:contexts": "node scripts/check-builtin-contexts.mjs",
    "check:published-boundaries": "node scripts/check-published-boundaries.mjs && node --test scripts/check-agent-wire.test.mjs && node scripts/check-agent-wire.mjs",
    "check:layers": "node --test scripts/check-layers.test.mjs && node scripts/check-layers.mjs",
    "check:port-surface": "node --test scripts/check-port-surface.test.mjs && node scripts/check-port-surface.mjs",
    "check:api-consumers": "node --test scripts/check-backend-api-consumers.test.mjs && node scripts/check-backend-api-consumers.mjs",
    "check:hmr": "node scripts/check-hmr-disposal.mjs",
    "check:style-invalidation": "node scripts/check-style-invalidation.mjs",
    "check:design-system": "node scripts/check-design-system-boundaries.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:chrome": "node scripts/check-interactive-chrome.mjs",
    "check:locales": "node --test scripts/check-locales.test.mjs && node scripts/check-locales.mjs",
    "check:lookup-tables": "node scripts/check-lookup-tables.mjs",
    "check:bundle": "node --test scripts/check-bundle-size.test.mjs && vite build && node scripts/check-css-variables.mjs && node scripts/check-bundle-size.mjs",
    "check:plugin-resources": "node ../../plugins/scripts/build-components.mjs --check",
    "check:plugin-modules": "node scripts/check-plugin-modules.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run knip && npm run check:circular && npm run check:contexts && npm run check:published-boundaries && npm run check:layers && npm run check:port-surface && npm run check:api-consumers && npm run check:style-invalidation && npm run check:hmr && npm run check:design-system && npm run check:tokens && npm run check:styles && npm run check:dead-tokens && npm run check:classes && npm run check:shorthand && npm run check:chrome && npm run check:locales && npm run check:lookup-tables && npm run check:bootstrap && npm run check:plugin-resources && npm run check:bundle && npm run check:plugin-modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "build:dev": "vite build --mode development --minify false",
    "check:classes": "node scripts/check-authored-classes.mjs",
    "check:variables": "node scripts/check-css-variables.mjs",
    "check:shorthand": "node scripts/check-shorthand-longhand.mjs",
    "check:dead-tokens": "node scripts/check-dead-tokens.mjs",
    "check:styles": "node scripts/check-dead-styles.mjs",
    "lab": "vite --config vite.lab.config.ts --open /lab/",
    "lab:build": "vite build --config vite.lab.config.ts && node scripts/check-lab-build.mjs",
    "lab:verify": "playwright test --config playwright.lab.config.ts --project=light-en --project=dark-zh --project=interactions",
    "lab:measure": "playwright test --config playwright.lab.config.ts --project=performance"
  },
  "dependencies": {
    "@flame/brand-assets": "*",
    "@base-ui/react": "^1.9.0",
    "@flame/component-sdk": "*",
    "@flame/icons": "*",
    "@flame/runtime-client": "*",
    "@flame/ui": "*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@wailsio/runtime": "3.1.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "dougong": "0.11.0",
    "i18next": "^27.1.0",
    "katex": "0.19.1",
    "mdast-util-math": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "motion": "^14.11.1",
    "pele": "^1.13.0",
    "quick-lru": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remend": "^1.4.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tinykeys": "^4.0.1",
    "unified": "11.0.5",
    "unist-util-visit": "^5.2.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "@frame/sdk": "https://github.com/Tangerg/frame/releases/download/v0.2.0/frame-sdk-0.2.0.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.0",
    "@playwright/test": "^1.65.0",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/culori": "^4.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.4",
    "jsonc-parser": "3.3.1",
    "knip": "^6.44.2",
    "mdast-util-from-markdown": "2.1.0",
    "micromark-util-types": "2.0.3",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "flame": {
    "buildDependencies": [
      "@flame/plugins"
    ]
  }
}
