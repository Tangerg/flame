{
  "name": "@flame/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/check-locales.mjs",
    "check:bundle": "node --test scripts/check-bundle-artifacts.test.mjs webArtifacts.test.mjs && vite build && node scripts/check-bundle-artifacts.mjs",
    "check:plugin-resources": "node ../../plugins/scripts/build-components.mjs --check",
    "check:plugin-modules": "node scripts/check-plugin-modules.mjs",
    "check": "npm run typecheck && npm run test && npm run check:locales && npm run check:bootstrap && npm run check:plugin-resources && npm run check:bundle && npm run check:plugin-modules",
    "format": "prettier --write .",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "build:dev": "vite build --mode development --minify false",
    "lab": "vite --config vite.lab.config.ts --open /lab/",
    "lab:build": "vite build --config vite.lab.config.ts && node scripts/check-lab-build.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/react": "0.5.3",
    "@flame/brand-assets": "*",
    "@flame/component-sdk": "*",
    "@flame/icons": "*",
    "@flame/runtime-client": "*",
    "@flame/ui": "*",
    "@frame/sdk": "https://github.com/Tangerg/frame/releases/download/v0.5.0/frame-sdk-0.5.0.tgz",
    "@lexical/react": "0.53.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@pierre/diffs": "1.7.0-beta.3",
    "@tanstack/hotkeys": "0.31.0",
    "@tanstack/react-hotkeys": "0.26.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@wailsio/runtime": "3.1.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "dougong": "0.14.0",
    "i18next": "^27.1.0",
    "katex": "0.19.1",
    "lexical": "0.53.0",
    "motion": "^14.11.1",
    "pele": "^1.13.0",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.24.0",
    "react-zoom-pan-pinch": "4.2.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "unified": "11.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/culori": "^4.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "fake-indexeddb": "6.2.8",
    "jsonc-parser": "3.3.1",
    "parse5": "8.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "flame": {
    "buildDependencies": [
      "@flame/plugins"
    ]
  }
}
