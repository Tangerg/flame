{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "visual:dev": "vite --config vite.visual.config.ts",
    "visual:test": "playwright test --config playwright.visual.config.ts",
    "visual:test:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "perf:baseline": "playwright test --config playwright.perf.config.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src visual scripts --deny-warnings",
    "lint:fix": "oxlint src --fix --deny-warnings",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check:circular": "node scripts/check-circular.mjs",
    "check:contexts": "node scripts/check-builtin-contexts.mjs",
    "check:published-boundaries": "node scripts/check-published-boundaries.mjs",
    "check:layers": "node --test scripts/runtime-client-imports.test.mjs && node scripts/check-layers.mjs",
    "check:port-surface": "node scripts/check-port-surface.mjs",
    "check:api-consumers": "node --test scripts/check-backend-api-consumers.test.mjs && node scripts/check-backend-api-consumers.mjs",
    "check:hmr": "node scripts/check-hmr-disposal.mjs",
    "check:style-invalidation": "node scripts/check-style-invalidation.mjs",
    "check:design-system": "node scripts/check-design-system-boundaries.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:chrome": "node scripts/check-interactive-chrome.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:lookup-tables": "node scripts/check-lookup-tables.mjs",
    "check:bundle": "vite build && node scripts/check-css-variables.mjs && node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run knip && npm run check:circular && npm run check:contexts && npm run check:published-boundaries && npm run check:layers && npm run check:port-surface && npm run check:api-consumers && npm run check:style-invalidation && npm run check:hmr && npm run check:design-system && npm run check:tokens && npm run check:styles && npm run check:dead-tokens && npm run check:classes && npm run check:shorthand && npm run check:chrome && npm run check:locales && npm run check:lookup-tables && npm run check:bootstrap && npm run check:bundle",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd ../.. && desktop/frontend/node_modules/.bin/husky desktop/.husky",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "build:dev": "vite build --mode development --minify false",
    "check:classes": "node scripts/check-authored-classes.mjs",
    "check:variables": "node scripts/check-css-variables.mjs",
    "check:shorthand": "node scripts/check-shorthand-longhand.mjs",
    "check:dead-tokens": "node scripts/check-dead-tokens.mjs",
    "check:styles": "node scripts/check-dead-styles.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "src/**/*.{js,jsx,json,md,css,html}": "prettier --write",
    "*.{json,md,js,cjs,ts}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@flame/runtime-contract": "file:../../runtime/contract/typescript",
    "@lobehub/icons": "^5.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-virtual": "^3.14.13",
    "@wailsio/runtime": "3.0.0-beta.25",
    "beautiful-mermaid": "^1.1.3",
    "clsx": "^2.1.1",
    "colord": "^2.10.0",
    "dougong": "^0.7.0",
    "i18next": "^26.4.2",
    "katex": "^0.18.8",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.14",
    "motion": "^13.4.2",
    "nanoid": "^6.0.0",
    "quick-lru": "^7.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remend": "^1.3.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tinykeys": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "ajv": "^8.20.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-babel": "^1.7.3",
    "vitest": "^5.0.1"
  }
}
