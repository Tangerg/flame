{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GetPolicyV1Input": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "GetPolicyV1Output": {
      "$ref": "#/$defs/Snapshot"
    },
    "ReplaceInput": {
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 1,
          "type": "integer"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "maxItems": 3,
          "type": "array"
        }
      },
      "required": [
        "expectedRevision",
        "rules"
      ],
      "type": "object"
    },
    "ReplacePolicyV1Input": {
      "$ref": "#/$defs/ReplaceInput"
    },
    "ReplacePolicyV1Output": {
      "$ref": "#/$defs/Snapshot"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "ceiling": {
          "$ref": "#/$defs/SelectionLimits"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "use": {
          "allOf": [
            {
              "enum": [
                "interaction",
                "utility",
                "independent"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "use",
        "selection"
      ],
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "provider",
        "reasoningEffort"
      ],
      "type": "object"
    },
    "SelectionLimits": {
      "additionalProperties": false,
      "properties": {
        "inputKind": {
          "allOf": [
            {
              "enum": [
                "text",
                "request"
              ]
            }
          ],
          "type": "string"
        },
        "maxInputBytes": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 1,
          "type": "integer"
        },
        "maxOutputTokens": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "inputKind",
        "maxInputBytes",
        "maxOutputTokens"
      ],
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 1,
          "type": "integer"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "maxItems": 3,
          "type": "array"
        }
      },
      "required": [
        "revision",
        "rules"
      ],
      "type": "object"
    }
  }
}
