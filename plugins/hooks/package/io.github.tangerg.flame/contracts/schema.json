{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Advice": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/CommandDecision"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        }
      },
      "required": [
        "decision",
        "diagnostics"
      ],
      "type": "object"
    },
    "CommandDecision": {
      "additionalProperties": false,
      "properties": {
        "injectContext": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "rewriteArguments": {
          "type": "string"
        },
        "verdict": {
          "allOf": [
            {
              "enum": [
                "allow",
                "deny",
                "ask"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "verdict"
      ],
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "message"
      ],
      "type": "object"
    },
    "DiscoverV1Input": {
      "$ref": "#/$defs/Discovery"
    },
    "DiscoverV1Output": {
      "items": {
        "$ref": "#/$defs/Hook"
      },
      "type": "array"
    },
    "Discovery": {
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "type": "string"
        },
        "home": {
          "type": "string"
        },
        "includeProject": {
          "type": "boolean"
        },
        "projectRoot": {
          "type": "string"
        }
      },
      "required": [
        "cwd",
        "projectRoot",
        "includeProject"
      ],
      "type": "object"
    },
    "EvaluateV1Input": {
      "$ref": "#/$defs/Evaluation"
    },
    "EvaluateV1Output": {
      "$ref": "#/$defs/Advice"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "declarativeOnly": {
          "type": "boolean"
        },
        "input": {
          "$ref": "#/$defs/Input"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Hook"
          },
          "type": "array"
        }
      },
      "required": [
        "rules",
        "input"
      ],
      "type": "object"
    },
    "Hook": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "event": {
          "allOf": [
            {
              "enum": [
                "PreToolUse",
                "PostToolUse",
                "UserPromptSubmit",
                "SessionStart",
                "PreCompact",
                "Stop",
                "Notification"
              ]
            }
          ],
          "type": "string"
        },
        "inject": {
          "type": "string"
        },
        "matcher": {
          "type": "string"
        },
        "scope": {
          "allOf": [
            {
              "enum": [
                "global",
                "project"
              ]
            }
          ],
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "timeoutMillis": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        }
      },
      "required": [
        "event",
        "scope",
        "source"
      ],
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "type": "string"
        },
        "event": {
          "allOf": [
            {
              "enum": [
                "PreToolUse",
                "PostToolUse",
                "UserPromptSubmit",
                "SessionStart",
                "PreCompact",
                "Stop",
                "Notification"
              ]
            }
          ],
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "promptTruncated": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolInput"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    "ToolInput": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "resultTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  }
}
