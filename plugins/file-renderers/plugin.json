{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "flame.file-renderers",
  "version": "2.0.0",
  "description": "Optional read-only Markdown presentation of captured Runtime files.",
  "extensions": {
    "io.github.tangerg.flame": {
      "apiVersion": 1,
      "contributes": {
        "renderers": [
          {
            "id": "markdown",
            "title": "Markdown",
            "selector": {
              "type": "fileExtension",
              "name": "md"
            },
            "entry": "renderers/markdown.html"
          },
          {
            "id": "markdown-long",
            "title": "Markdown",
            "selector": {
              "type": "fileExtension",
              "name": "markdown"
            },
            "entry": "renderers/markdown.html"
          },
          {
            "id": "mdx",
            "title": "Markdown source",
            "selector": {
              "type": "fileExtension",
              "name": "mdx"
            },
            "entry": "renderers/markdown.html"
          }
        ]
      }
    }
  }
}
