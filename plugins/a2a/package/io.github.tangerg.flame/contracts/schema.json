{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "type": "object"
    },
    "Agents": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/Agent"
          },
          "type": "array"
        }
      },
      "required": [
        "agents"
      ],
      "type": "object"
    },
    "AgentsV1Input": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "AgentsV1Output": {
      "$ref": "#/$defs/Agents"
    },
    "CancelV1Input": {
      "$ref": "#/$defs/TaskRequest"
    },
    "CancelV1Output": {
      "$ref": "#/$defs/Result"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "task",
            "message"
          ],
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "valueJSON": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "agent",
        "kind",
        "valueJSON"
      ],
      "type": "object"
    },
    "SendRequest": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "agent",
        "message"
      ],
      "type": "object"
    },
    "SendV1Input": {
      "$ref": "#/$defs/SendRequest"
    },
    "SendV1Output": {
      "$ref": "#/$defs/Result"
    },
    "StatusV1Input": {
      "$ref": "#/$defs/TaskRequest"
    },
    "StatusV1Output": {
      "$ref": "#/$defs/Result"
    },
    "TaskRequest": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "requestId"
      ],
      "type": "object"
    }
  }
}
