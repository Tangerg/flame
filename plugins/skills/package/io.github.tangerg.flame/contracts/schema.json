{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArchiveAdvice": {
      "additionalProperties": false,
      "properties": {
        "inactiveSince": {
          "format": "date-time",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ArchiveRequest": {
      "additionalProperties": false,
      "properties": {
        "now": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "now"
      ],
      "type": "object"
    },
    "ArchiveV2Input": {
      "$ref": "#/$defs/ArchiveRequest"
    },
    "ArchiveV2Output": {
      "$ref": "#/$defs/ArchiveAdvice"
    },
    "MineResult": {
      "additionalProperties": false,
      "properties": {
        "proposal": {
          "$ref": "#/$defs/Proposal"
        }
      },
      "type": "object"
    },
    "MineV1Input": {
      "$ref": "#/$defs/Run"
    },
    "MineV1Output": {
      "$ref": "#/$defs/MineResult"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "revises": {
          "type": "boolean"
        },
        "skill": {
          "$ref": "#/$defs/Skill"
        }
      },
      "required": [
        "skill",
        "revises"
      ],
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "toolCalls": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sessionId",
        "toolCalls"
      ],
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "instructions"
      ],
      "type": "object"
    }
  }
}
