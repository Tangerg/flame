{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BrowseInput": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "limit": {
              "maximum": 8192
            }
          }
        }
      ],
      "properties": {
        "limit": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 0,
          "type": "integer"
        },
        "snapshotId": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "offset",
        "limit"
      ],
      "type": "object"
    },
    "BrowseV1Input": {
      "$ref": "#/$defs/BrowseInput"
    },
    "BrowseV1Output": {
      "$ref": "#/$defs/BrowseV1OutputDomainPage"
    },
    "BrowseV1OutputDomainPage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "format": {
          "allOf": [
            {
              "enum": [
                "markdown",
                "html",
                "text"
              ]
            }
          ],
          "type": "string"
        },
        "nextOffset": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "offset": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "snapshotId": {
          "type": "string"
        },
        "totalRunes": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "url",
        "format",
        "content",
        "offset",
        "totalRunes"
      ],
      "type": "object"
    },
    "FetchRequest": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "allOf": [
            {
              "enum": [
                "markdown",
                "html",
                "text"
              ]
            }
          ],
          "description": "Content format: markdown (default and best for readable structure), html, or text.",
          "type": "string"
        },
        "url": {
          "description": "Absolute http(s) URL of the page to fetch.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "FetchV1Input": {
      "$ref": "#/$defs/FetchRequest"
    },
    "FetchV1Output": {
      "$ref": "#/$defs/FetchV1OutputDomainPage"
    },
    "FetchV1OutputDomainPage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "format": {
          "allOf": [
            {
              "enum": [
                "markdown",
                "html",
                "text"
              ]
            }
          ],
          "type": "string"
        },
        "nextOffset": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "offset": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "snapshotId": {
          "type": "string"
        },
        "totalRunes": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "url",
        "format",
        "content",
        "offset",
        "totalRunes"
      ],
      "type": "object"
    },
    "HTTPContent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "string"
        },
        "encoding": {
          "enum": [
            "utf8",
            "base64"
          ],
          "type": "string"
        }
      },
      "required": [
        "encoding",
        "data"
      ],
      "type": "object"
    },
    "HTTPResponse": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/HTTPContent"
        },
        "duration": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/HTTPContent"
            },
            "type": "array"
          },
          "type": "object"
        },
        "status": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "body",
        "duration"
      ],
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "timeout_ms": {
              "maximum": 120000,
              "minimum": 1
            }
          }
        }
      ],
      "properties": {
        "body": {
          "description": "Optional request body for POST, PUT, PATCH, or DELETE; GET and HEAD carry none. For JSON, pass a JSON-encoded string and set Content-Type via Headers.",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional request headers. Values here override this tool's configured default headers. Host overrides are prohibited; authority comes from the URL.",
          "type": "object"
        },
        "method": {
          "allOf": [
            {
              "enum": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            }
          ],
          "description": "HTTP method: GET (default), HEAD, POST, PUT, PATCH, or DELETE. Must be in the configured method allowlist.",
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional query parameters appended to the URL; a name must not also appear in the URL's own query.",
          "type": "object"
        },
        "timeout_ms": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "description": "Per-call timeout in milliseconds, within the supported request limit. Omit to use the configured default.",
          "type": "integer"
        },
        "url": {
          "description": "Absolute http(s) URL. Host must match the configured allowlist.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "RequestV1Input": {
      "$ref": "#/$defs/Request"
    },
    "RequestV1Output": {
      "$ref": "#/$defs/HTTPResponse"
    },
    "SearchRequest": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "allowed_domains": {
              "maxItems": 20
            },
            "blocked_domains": {
              "maxItems": 20
            },
            "max_results": {
              "maximum": 20,
              "minimum": 1
            }
          }
        }
      ],
      "properties": {
        "allowed_domains": {
          "description": "Only include results from the allowed domains (bare domain names, no protocol). Mutually exclusive with blocked_domains.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "blocked_domains": {
          "description": "Exclude results from these domains (bare domain names, no protocol). Mutually exclusive with allowed_domains.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_results": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "description": "Maximum results to return within the supported search limit. Omit to use the configured search default (typically 5-10).",
          "type": "integer"
        },
        "query": {
          "description": "Non-empty web search query. Include the current year when asking for the latest information.",
          "minLength": 1,
          "type": "string"
        },
        "recency": {
          "allOf": [
            {
              "enum": [
                "hour",
                "day",
                "week",
                "month",
                "year"
              ]
            }
          ],
          "description": "Optional time window: hour, day, week, month, or year.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "SearchResponse": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/SearchResult"
          },
          "type": "array"
        }
      },
      "required": [
        "query",
        "results"
      ],
      "type": "object"
    },
    "SearchResult": {
      "additionalProperties": false,
      "properties": {
        "favicon_url": {
          "type": "string"
        },
        "published_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "snippet": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "snippet"
      ],
      "type": "object"
    },
    "SearchV1Input": {
      "$ref": "#/$defs/SearchRequest"
    },
    "SearchV1Output": {
      "$ref": "#/$defs/SearchResponse"
    },
    "Timestamp": {
      "type": "string"
    }
  }
}
