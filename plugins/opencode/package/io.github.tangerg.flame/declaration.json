    }
  ],
  "components": [
    {
      "id": "opencode-sessions",
      "title": "ACP sessions",
      "localizedTitles": {"zh": "ACP 会话", "zh-TW": "ACP 工作階段"},
      "scope": "client",
      "placement": "workspaceView",
      "entry": "io.github.tangerg.flame/components/component.js",
      "export": "OpenCodeSessions",
      "contribution": "native-sessions"
    }
