{
  "protocol": "io.github.tangerg.flame/plugin/1",
  "inputs": [
    {
      "id": "executable",
      "server": "opencode",
      "target": "env",
      "key": "OPENCODE_EXECUTABLE",
      "secret": false,
      "required": false
    },
    {
      "id": "agents",
      "server": "opencode",
      "target": "env",
      "key": "FLAME_ACP_AGENTS",
      "secret": false,
      "required": false
    }
