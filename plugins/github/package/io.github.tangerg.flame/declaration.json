{
  "protocol": "io.github.tangerg.flame/plugin/1",
  "inputs": [
    {
      "id": "token",
      "server": "github",
      "target": "env",
      "key": "GITHUB_TOKEN",
      "secret": true,
      "required": false
    },
    {
      "id": "review-checks",
      "server": "github",
      "target": "env",
      "key": "GITHUB_REVIEW_CHECKS",
      "secret": false,
      "required": false
    },
    {
      "id": "issue-delivery",
      "server": "github",
      "target": "env",
      "key": "GITHUB_ISSUE_DELIVERY",
      "secret": false,
      "required": false
    },
    {
      "id": "webhook-port",
      "server": "github",
      "target": "env",
      "key": "GITHUB_WEBHOOK_PORT",
      "secret": false,
      "required": false
    },
    {
      "id": "webhook-secret",
      "server": "github",
      "target": "env",
      "key": "GITHUB_WEBHOOK_SECRET",
      "secret": true,
      "required": false
    },
    {
      "id": "team-origin",
      "server": "github",
      "target": "env",
      "key": "FLAME_GITHUB_TEAM_ORIGIN",
      "secret": false,
      "required": false
    },
    {
      "id": "team-secret",
      "server": "github",
      "target": "env",
      "key": "FLAME_GITHUB_TEAM_SECRET",
      "secret": true,
      "required": false
    },
    {
      "id": "work-intake",
      "server": "github",
      "target": "env",
      "key": "FLAME_GITHUB_WORK_INTAKE",
      "secret": false,
      "required": false
    },
    {
      "id": "linear-secret",
      "server": "github",
      "target": "env",
      "key": "FLAME_LINEAR_SIGNING_SECRET",
      "secret": true,
      "required": false
    },
    {
      "id": "slack-secret",
      "server": "github",
      "target": "env",
      "key": "FLAME_SLACK_SIGNING_SECRET",
      "secret": true,
      "required": false
    }
  ],
  "contributions": [
    {
      "id": "github-operations",
      "background": true,
      "server": "github",
      "export": "github",
      "contract": "io.github.tangerg.flame/contracts/capability.generated.json"
    }
  ],
  "components": [
    {
      "id": "github-reviews",
      "material": "project-pr-reviews",
      "title": "Pull request reviews",
      "localizedTitles": {
        "zh": "PR 复审",
        "zh-TW": "PR 複審",
        "de": "Pull-Request-Prüfungen",
        "es": "Revisiones de pull requests",
        "fr": "Revues de pull requests",
        "ja": "プルリクエストレビュー",
        "ko": "풀 리퀘스트 검토"
      },
      "scope": "client",
      "placement": "workspaceView",
      "entry": "io.github.tangerg.flame/components/component.js",
      "export": "GitHubReviews",
      "contribution": "github-operations"
    },
    {
      "id": "github-issue-deliveries",
      "material": "project-issue-deliveries",
      "title": "Issue deliveries",
      "localizedTitles": {
        "zh": "Issue 交付",
        "zh-TW": "Issue 交付",
        "de": "Issue-Auslieferungen",
        "es": "Entregas de issues",
        "fr": "Livraisons d’issues",
        "ja": "Issue の成果報告",
        "ko": "이슈 인도"
      },
      "scope": "client",
      "placement": "workspaceView",
      "entry": "io.github.tangerg.flame/components/component.js",
      "export": "GitHubIssueDeliveries",
      "contribution": "github-operations"
    },
    {
      "id": "github-project-team",
      "material": "project-team",
      "title": "Team and work intake",
      "localizedTitles": {
        "zh": "团队与工作收件箱",
        "zh-TW": "團隊與工作收件匣"
      },
      "scope": "client",
      "placement": "workspaceView",
      "entry": "io.github.tangerg.flame/components/component.js",
      "export": "GitHubProjectTeam",
      "contribution": "github-operations"
    }
  ]
}
