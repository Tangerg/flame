{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Ack": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "CreateV1Input": {
      "$ref": "#/$defs/Draft"
    },
    "CreateV1Output": {
      "$ref": "#/$defs/Snapshot"
    },
    "DeleteV1Input": {
      "$ref": "#/$defs/ItemInput"
    },
    "DeleteV1Output": {
      "$ref": "#/$defs/Ack"
    },
    "Draft": {
      "additionalProperties": false,
      "properties": {
        "CWD": {
          "type": "string"
        },
        "Cron": {
          "type": "string"
        },
        "Enabled": {
          "type": "boolean"
        },
        "Instructions": {
          "type": "string"
        },
        "ModelSelection": {
          "$ref": "#/$defs/Selection"
        },
        "TimeZone": {
          "type": "string"
        },
        "Title": {
          "type": "string"
        }
      },
      "required": [
        "Title",
        "Instructions",
        "CWD",
        "ModelSelection",
        "Cron",
        "TimeZone",
        "Enabled"
      ],
      "type": "object"
    },
    "ItemInput": {
      "additionalProperties": false,
      "properties": {
        "ID": {
          "type": "string"
        }
      },
      "required": [
        "ID"
      ],
      "type": "object"
    },
    "ListInput": {
      "additionalProperties": false,
      "properties": {
        "Cursor": {
          "type": "string"
        },
        "Limit": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        }
      },
      "required": [
        "Cursor"
      ],
      "type": "object"
    },
    "ListV1Input": {
      "$ref": "#/$defs/ListInput"
    },
    "ListV1Output": {
      "$ref": "#/$defs/Page"
    },
    "ModelPatch": {
      "additionalProperties": false,
      "properties": {
        "Model": {
          "type": "string"
        },
        "Provider": {
          "type": "string"
        },
        "ReasoningEffort": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "NextCursor": {
          "type": "string"
        },
        "Rows": {
          "items": {
            "$ref": "#/$defs/Snapshot"
          },
          "type": "array"
        }
      },
      "required": [
        "Rows",
        "NextCursor"
      ],
      "type": "object"
    },
    "RunNowV1Input": {
      "$ref": "#/$defs/ItemInput"
    },
    "RunNowV1Output": {
      "$ref": "#/$defs/RunReference"
    },
    "RunReference": {
      "additionalProperties": false,
      "properties": {
        "RunID": {
          "type": "string"
        },
        "SessionID": {
          "type": "string"
        }
      },
      "required": [
        "SessionID",
        "RunID"
      ],
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "provider",
        "reasoningEffort"
      ],
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "CWD": {
          "type": "string"
        },
        "CreatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "Cron": {
          "type": "string"
        },
        "ID": {
          "type": "string"
        },
        "Instructions": {
          "type": "string"
        },
        "LastRunAt": {
          "format": "date-time",
          "type": "string"
        },
        "ModelSelection": {
          "$ref": "#/$defs/Selection"
        },
        "NextRunAt": {
          "format": "date-time",
          "type": "string"
        },
        "Revision": {
          "allOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          ],
          "type": "integer"
        },
        "TimeZone": {
          "type": "string"
        },
        "Title": {
          "type": "string"
        }
      },
      "required": [
        "ID",
        "Title",
        "Instructions",
        "CWD",
        "ModelSelection",
        "Cron",
        "TimeZone",
        "CreatedAt",
        "Revision"
      ],
      "type": "object"
    },
    "UpdateInput": {
      "additionalProperties": false,
      "properties": {
        "CWD": {
          "type": "string"
        },
        "Cron": {
          "type": "string"
        },
        "Enabled": {
          "type": "boolean"
        },
        "ExpectedRevision": {
          "allOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          ],
          "type": "integer"
        },
        "ID": {
          "type": "string"
        },
        "Instructions": {
          "type": "string"
        },
        "ModelSelection": {
          "$ref": "#/$defs/ModelPatch"
        },
        "TimeZone": {
          "type": "string"
        },
        "Title": {
          "type": "string"
        }
      },
      "required": [
        "ID",
        "ExpectedRevision",
        "ModelSelection"
      ],
      "type": "object"
    },
    "UpdateV1Input": {
      "$ref": "#/$defs/UpdateInput"
    },
    "UpdateV1Output": {
      "$ref": "#/$defs/Snapshot"
    }
  }
}
