{
  "protocol": "io.github.tangerg.flame/plugin/1",
  "contributions": [
    {
      "id": "schedules-provider",
      "background": true,
      "server": "schedules",
      "export": "schedules",
      "contract": "io.github.tangerg.flame/contracts/capability.generated.json"
    }
  ],
  "components": [
    {
      "id": "schedules",
      "title": "Schedules",
      "localizedTitles": {
        "zh": "计划任务",
        "zh-TW": "排程工作",
        "de": "Zeitpläne",
        "fr": "Tâches planifiées",
        "es": "Tareas programadas",
        "ja": "スケジュール",
        "ko": "예약 작업"
      },
      "scope": "client",
      "placement": "workspaceView",
      "entry": "io.github.tangerg.flame/components/component.js",
      "export": "Schedules",
      "contribution": "schedules-provider",
      "material": "schedules"
    }
  ],
  "terminalViews": [
    {
      "id": "schedules",
      "title": "Scheduled runs",
      "contribution": "schedules-provider",
      "list": {
        "method": "flame.schedules/list.v2",
        "rows": "rows",
        "key": "id",
        "paging": {
          "input": "cursor",
          "output": "nextCursor"
        },
        "columns": [
          {
            "title": "Title",
            "field": "title"
          },
          {
            "title": "Cron",
            "field": "cron"
          },
          {
            "title": "Time zone",
            "field": "timeZone"
          },
          {
            "title": "Next run",
            "field": "nextRunAt"
          },
          {
            "title": "Last run",
            "field": "lastRunAt"
          },
          {
            "title": "Workspace",
            "field": "cwd"
          }
        ]
      },
      "actions": [
        {
          "id": "create",
          "title": "Create schedule",
          "method": "flame.schedules/create.v2",
          "target": "view",
          "input": {
            "title": {
              "form": {
                "title": "Title",
                "default": {
                  "value": ""
                }
              }
            },
            "instructions": {
              "form": {
                "title": "Instructions"
              }
            },
            "cron": {
              "form": {
                "title": "Cron",
                "default": {
                  "value": "0 9 * * 1-5"
                }
              }
            },
            "timeZone": {
              "form": {
                "title": "Time zone",
                "default": {
                  "context": "timeZone"
                }
              }
            },
            "cwd": {
              "form": {
                "title": "Workspace",
                "default": {
                  "context": "workspace"
                }
              }
            },
            "modelSelection/provider": {
              "form": {
                "title": "Provider",
                "default": {
                  "value": ""
                }
              }
            },
            "modelSelection/model": {
              "form": {
                "title": "Model",
                "default": {
                  "value": ""
                }
              }
            },
            "modelSelection/reasoningEffort": {
              "value": ""
            },
            "enabled": {
              "value": true
            }
          }
        },
        {
          "id": "edit",
          "title": "Edit",
          "method": "flame.schedules/update.v2",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "title": {
              "form": {
                "title": "Title",
                "default": {
                  "row": "title"
                }
              }
            },
            "instructions": {
              "form": {
                "title": "Instructions",
                "default": {
                  "row": "instructions"
                }
              }
            },
            "cron": {
              "form": {
                "title": "Cron",
                "default": {
                  "row": "cron"
                }
              }
            },
            "timeZone": {
              "form": {
                "title": "Time zone",
                "default": {
                  "row": "timeZone"
                }
              }
            },
            "cwd": {
              "form": {
                "title": "Workspace",
                "default": {
                  "row": "cwd"
                }
              }
            },
            "modelSelection/provider": {
              "form": {
                "title": "Provider",
                "default": {
                  "row": "modelSelection/provider"
                }
              }
            },
            "modelSelection/model": {
              "form": {
                "title": "Model",
                "default": {
                  "row": "modelSelection/model"
                }
              }
            }
          }
        },
        {
          "id": "enable",
          "title": "Enable",
          "method": "flame.schedules/update.v2",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "modelSelection": {
              "value": {}
            },
            "enabled": {
              "value": true
            }
          }
        },
        {
          "id": "disable",
          "title": "Disable",
          "method": "flame.schedules/update.v2",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "modelSelection": {
              "value": {}
            },
            "enabled": {
              "value": false
            }
          }
        },
        {
          "id": "run",
          "title": "Run now",
          "method": "flame.schedules/runNow.v2",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            }
          }
        },
        {
          "id": "delete",
          "title": "Delete",
          "method": "flame.schedules/delete.v2",
          "target": "row",
          "confirm": true,
          "input": {
            "id": {
              "row": "id"
            }
          }
        }
      ]
    }
  ]
}
