{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Ack": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "AddInput": {
      "additionalProperties": false,
      "properties": {
        "CWD": {
          "type": "string"
        },
        "Content": {
          "type": "string"
        },
        "Scope": {
          "allOf": [
            {
              "enum": [
                "project",
                "user"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "Scope",
        "CWD",
        "Content"
      ],
      "type": "object"
    },
    "AddResult": {
      "additionalProperties": false,
      "properties": {
        "Changed": {
          "type": "boolean"
        },
        "Item": {
          "$ref": "#/$defs/ItemSnapshot"
        }
      },
      "required": [
        "Item",
        "Changed"
      ],
      "type": "object"
    },
    "AddV2Input": {
      "$ref": "#/$defs/AddInput"
    },
    "AddV2Output": {
      "$ref": "#/$defs/AddResult"
    },
    "Conversation": {
      "additionalProperties": false,
      "properties": {
        "MessageCount": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "Transcript": {
          "type": "string"
        }
      },
      "required": [
        "MessageCount",
        "Transcript"
      ],
      "type": "object"
    },
    "DeleteV2Input": {
      "$ref": "#/$defs/ItemInput"
    },
    "DeleteV2Output": {
      "$ref": "#/$defs/Ack"
    },
    "ItemID": {
      "allOf": [
        {
          "pattern": "^mem_[0-9a-f]{32}$"
        }
      ],
      "type": "string"
    },
    "ItemInput": {
      "additionalProperties": false,
      "properties": {
        "ExpectedRevision": {
          "allOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          ],
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "ID": {
          "type": "string"
        }
      },
      "required": [
        "ID",
        "ExpectedRevision"
      ],
      "type": "object"
    },
    "ItemSnapshot": {
      "additionalProperties": false,
      "properties": {
        "Content": {
          "maxLength": 4096,
          "pattern": "\\S",
          "type": "string"
        },
        "CreatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "Day": {
          "type": "string"
        },
        "Embedding": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "EmbeddingSpace": {
          "type": "string"
        },
        "ID": {
          "$ref": "#/$defs/ItemID"
        },
        "Origin": {
          "allOf": [
            {
              "enum": [
                "auto",
                "user"
              ]
            }
          ],
          "type": "string"
        },
        "Pinned": {
          "type": "boolean"
        },
        "Project": {
          "type": "string"
        },
        "Revision": {
          "allOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          ],
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "Scope": {
          "allOf": [
            {
              "enum": [
                "project",
                "user"
              ]
            }
          ],
          "type": "string"
        },
        "SessionID": {
          "type": "string"
        },
        "Status": {
          "allOf": [
            {
              "enum": [
                "active",
                "pending",
                "rejected"
              ]
            }
          ],
          "type": "string"
        },
        "UpdatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "ID",
        "Revision",
        "Scope",
        "Project",
        "Content",
        "Origin",
        "Status",
        "Pinned",
        "SessionID",
        "Day",
        "CreatedAt",
        "UpdatedAt",
        "EmbeddingSpace",
        "Embedding"
      ],
      "type": "object"
    },
    "ItemsInput": {
      "additionalProperties": false,
      "properties": {
        "Project": {
          "type": "string"
        },
        "Scope": {
          "allOf": [
            {
              "enum": [
                "project",
                "user"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "Scope",
        "Project"
      ],
      "type": "object"
    },
    "ItemsV2Input": {
      "$ref": "#/$defs/ItemsInput"
    },
    "ItemsV2Output": {
      "items": {
        "$ref": "#/$defs/ItemSnapshot"
      },
      "type": "array"
    },
    "ListInput": {
      "additionalProperties": false,
      "properties": {
        "CWD": {
          "type": "string"
        },
        "Cursor": {
          "type": "string"
        },
        "Limit": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "Scope": {
          "allOf": [
            {
              "enum": [
                "project",
                "user"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "Scope",
        "CWD",
        "Cursor"
      ],
      "type": "object"
    },
    "ListV2Input": {
      "$ref": "#/$defs/ListInput"
    },
    "ListV2Output": {
      "$ref": "#/$defs/Page"
    },
    "MaintainV1Input": {
      "$ref": "#/$defs/MaintenanceInput"
    },
    "MaintainV1Output": {
      "$ref": "#/$defs/MaintenanceResult"
    },
    "MaintenanceInput": {
      "additionalProperties": false,
      "properties": {
        "Compacted": {
          "type": "boolean"
        },
        "Conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "Project": {
          "type": "string"
        },
        "SessionID": {
          "type": "string"
        }
      },
      "required": [
        "SessionID",
        "Project",
        "Compacted",
        "Conversation"
      ],
      "type": "object"
    },
    "MaintenanceResult": {
      "additionalProperties": false,
      "properties": {
        "Published": {
          "type": "boolean"
        }
      },
      "required": [
        "Published"
      ],
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "Capacity": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "const": 512,
          "type": "integer"
        },
        "NextCursor": {
          "type": "string"
        },
        "Rows": {
          "items": {
            "$ref": "#/$defs/ItemSnapshot"
          },
          "maxItems": 100,
          "type": "array"
        }
      },
      "required": [
        "Rows",
        "NextCursor",
        "Capacity"
      ],
      "type": "object"
    },
    "ReviewInput": {
      "additionalProperties": false,
      "properties": {
        "Decision": {
          "allOf": [
            {
              "enum": [
                "approve",
                "reject"
              ]
            }
          ],
          "type": "string"
        },
        "ExpectedRevision": {
          "allOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          ],
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "ID": {
          "type": "string"
        }
      },
      "required": [
        "ID",
        "ExpectedRevision",
        "Decision"
      ],
      "type": "object"
    },
    "ReviewV2Input": {
      "$ref": "#/$defs/ReviewInput"
    },
    "ReviewV2Output": {
      "$ref": "#/$defs/Ack"
    },
    "SearchInput": {
      "additionalProperties": false,
      "properties": {
        "EmbeddingSpace": {
          "type": "string"
        },
        "Project": {
          "type": "string"
        },
        "Query": {
          "type": "string"
        },
        "TopK": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        }
      },
      "required": [
        "Project",
        "Query",
        "TopK",
        "EmbeddingSpace"
      ],
      "type": "object"
    },
    "SearchV2Input": {
      "$ref": "#/$defs/SearchInput"
    },
    "SearchV2Output": {
      "items": {
        "$ref": "#/$defs/ItemSnapshot"
      },
      "type": "array"
    },
    "UpdateInput": {
      "additionalProperties": false,
      "properties": {
        "Content": {
          "type": "string"
        },
        "ExpectedRevision": {
          "allOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          ],
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "ID": {
          "type": "string"
        },
        "Pinned": {
          "type": "boolean"
        }
      },
      "required": [
        "ID",
        "ExpectedRevision"
      ],
      "type": "object"
    },
    "UpdateV2Input": {
      "$ref": "#/$defs/UpdateInput"
    },
    "UpdateV2Output": {
      "$ref": "#/$defs/ItemSnapshot"
    }
  }
}
