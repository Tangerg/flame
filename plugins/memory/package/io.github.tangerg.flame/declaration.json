{
  "protocol": "io.github.tangerg.flame/plugin/1",
  "contributions": [
    {
      "id": "memory-provider",
      "server": "memory",
      "export": "memory",
      "contract": "io.github.tangerg.flame/contracts/capability.generated.json"
    }
  ],
  "components": [
    {
      "id": "memory",
      "title": "Agent memory",
      "localizedTitles": {
        "zh": "智能体记忆",
        "zh-TW": "代理程式記憶",
        "de": "Agentengedächtnis",
        "fr": "Mémoire de l’agent",
        "es": "Memoria del agente",
        "ja": "エージェントメモリ",
        "ko": "에이전트 메모리"
      },
      "scope": "client",
      "placement": "workspaceView",
      "entry": "io.github.tangerg.flame/components/component.js",
      "export": "Memory",
      "contribution": "memory-provider",
      "material": "memory"
    }
  ],
  "terminalViews": [
    {
      "id": "memory",
      "title": "Agent memory",
      "contribution": "memory-provider",
      "list": {
        "method": "flame.memory/list.v3",
        "rows": "rows",
        "key": "id",
        "paging": {
          "input": "cursor",
          "output": "nextCursor"
        },
        "input": {
          "cwd": {
            "context": "workspace"
          },
          "scope": {
            "form": {
              "title": "Scope",
              "default": {
                "value": "project"
              }
            }
          }
        },
        "columns": [
          {
            "title": "Status",
            "field": "status"
          },
          {
            "title": "Pinned",
            "field": "pinned"
          },
          {
            "title": "Origin",
            "field": "origin"
          },
          {
            "title": "Content",
            "field": "content"
          },
          {
            "title": "Updated",
            "field": "updatedAt"
          }
        ]
      },
      "actions": [
        {
          "id": "add",
          "title": "Add memory",
          "method": "flame.memory/add.v3",
          "target": "view",
          "input": {
            "cwd": {
              "context": "workspace"
            },
            "scope": {
              "form": {
                "title": "Scope",
                "default": {
                  "value": "project"
                }
              }
            },
            "content": {
              "form": {
                "title": "Content"
              }
            }
          }
        },
        {
          "id": "edit",
          "title": "Edit",
          "method": "flame.memory/update.v3",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "content": {
              "form": {
                "title": "Content",
                "default": {
                  "row": "content"
                }
              }
            }
          }
        },
        {
          "id": "pin",
          "title": "Pin",
          "method": "flame.memory/update.v3",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "pinned": {
              "value": true
            }
          }
        },
        {
          "id": "unpin",
          "title": "Unpin",
          "method": "flame.memory/update.v3",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "pinned": {
              "value": false
            }
          }
        },
        {
          "id": "approve",
          "title": "Approve",
          "method": "flame.memory/review.v3",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "decision": {
              "value": "approve"
            }
          }
        },
        {
          "id": "reject",
          "title": "Reject",
          "method": "flame.memory/review.v3",
          "target": "row",
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            },
            "decision": {
              "value": "reject"
            }
          }
        },
        {
          "id": "delete",
          "title": "Delete",
          "method": "flame.memory/delete.v3",
          "target": "row",
          "confirm": true,
          "input": {
            "id": {
              "row": "id"
            },
            "expectedRevision": {
              "row": "revision"
            }
          }
        }
      ]
    }
  ]
}
