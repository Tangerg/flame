{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "flame.memory",
  "version": "4.0.0",
  "description": "Owns durable memory, review, mining, curation and retrieval in a private backend. Host commands and model tools use the same owner.",
  "extensions": {
    "io.github.tangerg.flame": {
      "apiVersion": 1,
      "contributes": {
        "views": [
          {
            "id": "memory",
            "title": "Agent memory",
            "type": "agentMemory",
            "entry": "views/memory.html"
          }
        ],
        "services": [
          {
            "type": "memory",
            "server": "memory"
          }
        ]
      }
    }
  }
}
