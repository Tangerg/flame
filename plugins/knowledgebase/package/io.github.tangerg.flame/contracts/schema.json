{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Content": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "source",
        "text"
      ],
      "type": "object"
    },
    "DeleteV1Input": {
      "$ref": "#/$defs/DocumentInput"
    },
    "DeleteV1Output": {
      "type": "boolean"
    },
    "DocumentInput": {
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "expectedRevision"
      ],
      "type": "object"
    },
    "DocumentRead": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/Header"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "document",
        "text"
      ],
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "source",
        "revision",
        "chunks",
        "space"
      ],
      "type": "object"
    },
    "ImportInput": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/Content"
        },
        "expectedRevision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "content",
        "expectedRevision"
      ],
      "type": "object"
    },
    "ImportV1Input": {
      "$ref": "#/$defs/ImportInput"
    },
    "ImportV1Output": {
      "$ref": "#/$defs/Header"
    },
    "ListV1Input": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "ListV1Output": {
      "items": {
        "$ref": "#/$defs/Header"
      },
      "type": "array"
    },
    "Match": {
      "additionalProperties": false,
      "properties": {
        "chunk": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "document": {
          "$ref": "#/$defs/Header"
        },
        "score": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "document",
        "chunk",
        "text",
        "score"
      ],
      "type": "object"
    },
    "ReadInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ReadV1Input": {
      "$ref": "#/$defs/ReadInput"
    },
    "ReadV1Output": {
      "$ref": "#/$defs/DocumentRead"
    },
    "ReindexV1Input": {
      "$ref": "#/$defs/DocumentInput"
    },
    "ReindexV1Output": {
      "$ref": "#/$defs/Header"
    },
    "SearchInput": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "query",
        "limit"
      ],
      "type": "object"
    },
    "SearchV1Input": {
      "$ref": "#/$defs/SearchInput"
    },
    "SearchV1Output": {
      "items": {
        "$ref": "#/$defs/Match"
      },
      "type": "array"
    }
  }
}
