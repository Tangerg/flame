{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ExecuteInput": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "script": {
              "maxLength": 65536
            },
            "timeoutMillis": {
              "maximum": 30000
            }
          }
        }
      ],
      "properties": {
        "script": {
          "minLength": 1,
          "type": "string"
        },
        "timeoutMillis": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "script",
        "timeoutMillis"
      ],
      "type": "object"
    },
    "ExecuteV1Input": {
      "$ref": "#/$defs/ExecuteInput"
    },
    "ExecuteV1Output": {
      "$ref": "#/$defs/Result"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "cpuAndMemoryQuotas": {
          "type": "boolean"
        },
        "maxScriptBytes": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "maxTimeoutMillis": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "platform": {
          "type": "string"
        },
        "retainedBytesPerStream": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        }
      },
      "required": [
        "available",
        "platform",
        "maxScriptBytes",
        "maxTimeoutMillis",
        "retainedBytesPerStream",
        "cpuAndMemoryQuotas"
      ],
      "type": "object"
    },
    "LimitsV1Input": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "LimitsV1Output": {
      "$ref": "#/$defs/Limits"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "encoding": {
          "allOf": [
            {
              "enum": [
                "utf8",
                "base64"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "encoding",
        "content"
      ],
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "durationMillis": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "minimum": 0,
          "type": "integer"
        },
        "exitCode": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "status": {
          "allOf": [
            {
              "enum": [
                "completed",
                "timed_out"
              ]
            }
          ],
          "type": "string"
        },
        "stderr": {
          "$ref": "#/$defs/Output"
        },
        "stdout": {
          "$ref": "#/$defs/Output"
        }
      },
      "required": [
        "status",
        "exitCode",
        "durationMillis",
        "stdout",
        "stderr"
      ],
      "type": "object"
    }
  }
}
