{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FormatV1Input": {
      "$ref": "#/$defs/FormatV1InputCodeintelDocument"
    },
    "FormatV1InputCodeintelDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/FormatV1InputValueDigest"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "path",
        "version",
        "content"
      ],
      "type": "object"
    },
    "FormatV1InputValueDigest": {
      "allOf": [
        {
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "type": "string"
    },
    "FormatV1Output": {
      "$ref": "#/$defs/Transformation"
    },
    "FormatV1OutputValueDigest": {
      "allOf": [
        {
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "type": "string"
    },
    "InspectV1Input": {
      "$ref": "#/$defs/Inspection"
    },
    "InspectV1InputCodeintelDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/InspectV1InputValueDigest"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "path",
        "version",
        "content"
      ],
      "type": "object"
    },
    "InspectV1InputValueDigest": {
      "allOf": [
        {
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "type": "string"
    },
    "InspectV1Output": {
      "$ref": "#/$defs/Report"
    },
    "InspectV1OutputValueDigest": {
      "allOf": [
        {
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "type": "string"
    },
    "Inspection": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "document": {
          "$ref": "#/$defs/InspectV1InputCodeintelDocument"
        }
      },
      "required": [
        "document",
        "baseline"
      ],
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "problems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/InspectV1OutputValueDigest"
        }
      },
      "required": [
        "version",
        "problems",
        "summary"
      ],
      "type": "object"
    },
    "Transformation": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/FormatV1OutputValueDigest"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    }
  }
}
