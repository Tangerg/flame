{
  "name": "@flame/plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-components.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint */component scripts --deny-warnings",
    "format:check": "prettier --check */component scripts package.json tsconfig.json",
    "check:resources": "node scripts/build-components.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test scripts/build-release.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:i18n && npm run check:resources",
    "generate": "npm run build"
  },
  "dependencies": {
    "@flame/icons": "*",
    "@flame/component-sdk": "*",
    "@flame/runtime-client": "*",
    "@flame/ui": "*",
    "marked": "18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2"
  }
}
