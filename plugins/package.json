{
  "name": "@flame/plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-components.mjs",
    "typecheck": "tsc --noEmit && tsc -p backend.tsconfig.json",
    "lint": "oxlint */component */backend */contracts scripts --deny-warnings",
    "format:check": "prettier --check */component */backend */contracts scripts package.json tsconfig.json backend.tsconfig.json",
    "check:resources": "node scripts/build-components.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test scripts/*.test.mjs && node scripts/test-sources.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:i18n && npm run check:resources",
    "generate": "node scripts/generate-contracts.mjs && npm run build"
  },
  "dependencies": {
    "@flame/brand-assets": "*",
    "@flame/backend-sdk": "^0.1.0",
    "@flame/component-sdk": "*",
    "@flame/icons": "*",
    "@flame/runtime-client": "*",
    "@flame/ui": "*",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@qimu/node": "*",
    "@qimu/sdk": "0.1.0",
    "docx": "9.15.0",
    "exceljs": "4.4.0",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "pdf-lib": "1.17.1",
    "pigeon-maps": "0.22.1",
    "pptxgenjs": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
