{
  "name": "@flame/portable-views",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-components.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint */src/*.tsx build-*.mjs --deny-warnings",
    "format:check": "prettier --check */src/*.tsx build-*.mjs package.json tsconfig.json",
    "check:resources": "node build-components.mjs --check",
    "test": "node --test build-release.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:resources"
  },
  "dependencies": {
    "@flame/icons": "file:../icons",
    "@flame/plugin-sdk": "file:../plugin-sdk",
    "@flame/runtime-contract": "file:../runtime/contract/typescript",
    "@flame/ui": "file:../ui",
    "marked": "18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2"
  }
}
