{
  "protocol": "io.github.tangerg.qimu/portable/1",
  "reference": "io.github.tangerg.flame.examples/reviews.analyzer",
  "composition": "collection",
  "scope": "installation",
  "methods": [
    {
      "name": "io.github.tangerg.flame.examples/reviews.analyze",
      "kind": "query",
      "target": "installation",
      "description": "Analyze an inspected review snapshot and return findings without changing its records.",
      "input": {
        "$defs": {
          "contract.Snapshot": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "allOf": [
                  {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808
                  }
                ],
                "type": "integer"
              },
              "status": {
                "allOf": [
                  {
                    "enum": [
                      "open",
                      "resolved"
                    ]
                  }
                ],
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "status",
              "revision"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "allOf": [
              {
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808
              }
            ],
            "type": "integer"
          },
          "status": {
            "allOf": [
              {
                "enum": [
                  "open",
                  "resolved"
                ]
              }
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "revision"
        ],
        "type": "object"
      },
      "output": {
        "$defs": {
          "contract.Finding": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "reviewId": {
                "type": "string"
              },
              "revision": {
                "allOf": [
                  {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808
                  }
                ],
                "type": "integer"
              }
            },
            "required": [
              "code",
              "message",
              "reviewId",
              "revision"
            ],
            "type": "object"
          },
          "contract.Findings": {
            "additionalProperties": false,
            "properties": {
              "findings": {
                "items": {
                  "$ref": "#/$defs/contract.Finding"
                },
                "type": "array"
              }
            },
            "required": [
              "findings"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/$defs/contract.Finding"
            },
            "type": "array"
          }
        },
        "required": [
          "findings"
        ],
        "type": "object"
      }
    }
  ]
}
