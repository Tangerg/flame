{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "reviewId": {
          "type": "string"
        },
        "revision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message",
        "reviewId",
        "revision"
      ],
      "type": "object"
    },
    "Findings": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        }
      },
      "required": [
        "findings"
      ],
      "type": "object"
    },
    "ReviewsAnalyzeInput": {
      "$ref": "#/$defs/Snapshot"
    },
    "ReviewsAnalyzeOutput": {
      "$ref": "#/$defs/Findings"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "status": {
          "allOf": [
            {
              "enum": [
                "open",
                "resolved"
              ]
            }
          ],
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "revision"
      ],
      "type": "object"
    }
  }
}
