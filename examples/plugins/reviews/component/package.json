{
  "name": "@flame/reviews-example",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "generate": "npm run build",
    "lint": "oxlint *.tsx build.mjs --deny-warnings",
    "format:check": "prettier --check *.tsx build.mjs package.json tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@flame/component-sdk": "*",
    "@flame/ui": "*",
    "@flame/runtime-client": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@frame/sdk": "https://github.com/Tangerg/frame/releases/download/v0.1.0/frame-sdk-0.1.0.tgz"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "rolldown": "^1.2.16",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10"
  }
}
