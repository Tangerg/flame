{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "review",
        "findings"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "reviewId": {
          "type": "string"
        },
        "revision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message",
        "reviewId",
        "revision"
      ],
      "type": "object"
    },
    "ListResult": {
      "additionalProperties": false,
      "properties": {
        "reviews": {
          "items": {
            "$ref": "#/$defs/Snapshot"
          },
          "type": "array"
        }
      },
      "required": [
        "reviews"
      ],
      "type": "object"
    },
    "ReviewsAnalyzersInput": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "ReviewsAnalyzersOutput": {
      "$ref": "#/$defs/Analysis"
    },
    "ReviewsListInput": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "ReviewsListOutput": {
      "$ref": "#/$defs/ListResult"
    },
    "ReviewsUpdateInput": {
      "$ref": "#/$defs/Update"
    },
    "ReviewsUpdateOutput": {
      "$ref": "#/$defs/UpdateResult"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "status": {
          "allOf": [
            {
              "enum": [
                "open",
                "resolved"
              ]
            }
          ],
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "revision"
      ],
      "type": "object"
    },
    "Update": {
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "allOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808
            }
          ],
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "type": "string"
        },
        "status": {
          "allOf": [
            {
              "enum": [
                "open",
                "resolved"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "expectedRevision",
        "status"
      ],
      "type": "object"
    },
    "UpdateResult": {
      "additionalProperties": false,
      "properties": {
        "review": {
          "$ref": "#/$defs/Snapshot"
        },
        "type": {
          "allOf": [
            {
              "enum": [
                "updated",
                "revisionConflict",
                "notFound",
                "invalidUpdate",
                "invocationConflict",
                "revisionExhausted"
              ]
            }
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  }
}
