{
  "name": "@qimu/browser",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "@qimu/sdk": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool forks --execArgv=--expose-gc",
    "lint": "oxlint src --deny-warnings",
    "format:check": "prettier --check src package.json tsconfig.json README.md",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  }
}
