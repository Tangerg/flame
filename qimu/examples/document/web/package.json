{
  "name": "@qimu/example-document-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:workflow": "node --test workflow.test.mjs",
    "lint": "oxlint src --deny-warnings",
    "format:check": "prettier --ignore-path ../../../../.prettierignore --check *.mjs src package.json tsconfig.json vite.config.ts index.html",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "test:browser": "node --test browser.test.mjs"
  },
  "dependencies": {
    "@qimu/sdk": "*",
    "@qimu/browser": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1"
  }
}
