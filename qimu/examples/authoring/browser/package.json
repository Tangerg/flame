{
  "name": "@qimu/example-author-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test:workflow": "node --test workflow.test.mjs",
    "lint": "oxlint src *.mjs --deny-warnings",
    "format:check": "prettier --ignore-path ../../../../.prettierignore --check src *.mjs package.json tsconfig.json README.md",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@qimu/sdk": "*",
    "@qimu/browser": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  }
}
