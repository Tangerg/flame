{
  "name": "@flame/component-sdk",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./build.mjs",
    "./notifications": "./src/notificationAuthorization.generated.ts",
    "./runtime-profile": "./src/runtime-profile.generated.ts"
  },
  "files": [
    "src",
    "build.mjs",
    "README.md",
    "runtime-profile.json",
    "runtime-profile.generated.json"
  ],
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@flame/ui": "*",
    "@flame/runtime-client": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "rolldown": "^1.3.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test build.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "lint": "oxlint src build.mjs build.test.mjs --deny-warnings",
    "format:check": "prettier --check src build.mjs build.test.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@frame/sdk": "https://github.com/Tangerg/frame/releases/download/v0.2.0/frame-sdk-0.2.0.tgz"
  }
}
