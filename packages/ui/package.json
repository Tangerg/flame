{
  "name": "@flame/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "stylex": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.stylex": {
      "types": "./dist/tokens.stylex.d.ts",
      "import": "./src/tokens.stylex.ts"
    },
    "./styles.css": {
      "stylex": "./src/globals.css",
      "default": "./dist/styles.css"
    },
    "./button": {
      "stylex": "./src/button.tsx",
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./badge": {
      "stylex": "./src/badge.tsx",
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./tooltip": {
      "stylex": "./src/tooltip.tsx",
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./floating-surface": {
      "stylex": "./src/floating-surface.tsx",
      "types": "./dist/floating-surface.d.ts",
      "import": "./dist/floating-surface.js"
    },
    "./text-field": {
      "stylex": "./src/text-field.tsx",
      "types": "./dist/text-field.d.ts",
      "import": "./dist/text-field.js"
    },
    "./icon-button": {
      "stylex": "./src/icon-button.tsx",
      "types": "./dist/icon-button.d.ts",
      "import": "./dist/icon-button.js"
    },
    "./icon-scale": {
      "stylex": "./src/icon-scale.ts",
      "types": "./dist/icon-scale.d.ts",
      "import": "./dist/icon-scale.js"
    },
    "./empty-state": {
      "stylex": "./src/empty-state.tsx",
      "types": "./dist/empty-state.d.ts",
      "import": "./dist/empty-state.js"
    },
    "./glyph-swap": {
      "stylex": "./src/glyph-swap.tsx",
      "types": "./dist/glyph-swap.d.ts",
      "import": "./dist/glyph-swap.js"
    },
    "./vocabulary": {
      "stylex": "./src/vocabulary.ts",
      "types": "./dist/vocabulary.d.ts",
      "import": "./dist/vocabulary.js"
    },
    "./tone-ink": {
      "stylex": "./src/tone-ink.ts",
      "types": "./dist/tone-ink.d.ts",
      "import": "./dist/tone-ink.js"
    },
    "./typography": {
      "stylex": "./src/typography.ts",
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js"
    },
    "./well-surface": {
      "stylex": "./src/well-surface.ts",
      "types": "./dist/well-surface.d.ts",
      "import": "./dist/well-surface.js"
    },
    "./panel": {
      "stylex": "./src/panel.tsx",
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./checkbox": {
      "stylex": "./src/checkbox.tsx",
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./select": {
      "stylex": "./src/select.tsx",
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint src scripts test --deny-warnings",
    "format:check": "prettier --check src scripts test README.md package.json tsconfig.json vitest.config.ts",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test && node --test test/package.test.mjs"
  },
  "peerDependencies": {
    "motion": "^14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@flame/icons": "*",
    "@stylexjs/stylex": "^0.19.1",
    "@types/mdast": "^4.0.4",
    "clsx": "^2.1.1",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@flame/icons": "*",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "motion": "^14.11.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
