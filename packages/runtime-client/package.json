{
  "name": "@flame/runtime-client",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/generated/wire.generated.ts",
    "./methods": "./src/generated/wire.methods.generated.ts",
    "./validation": "./src/validation/index.ts",
    "./testing": "./testing/index.ts",
    "./testing/samples/*": "./testing/generated/samples/*",
    "./testing/skill-pages.json": "./testing/generated/skill-pages.json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "eventsource-parser": "^4.1.3",
    "zod": "^4.6.7",
    "@frame/sdk": "https://github.com/Tangerg/frame/releases/download/v0.2.0/frame-sdk-0.2.0.tgz"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "lint": "oxlint src testing --deny-warnings",
    "format:check": "prettier --check src testing package.json tsconfig.json",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run knip"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "knip": "^6.44.2"
  },
  "files": [
    "src",
    "testing",
    "README.md"
  ]
}
