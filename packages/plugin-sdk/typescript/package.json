{
  "name": "@flame/backend-sdk",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./build": "./build.mjs"
  },
  "files": [
    "src",
    "build.mjs",
    "README.md"
  ],
  "dependencies": {
    "@flame/runtime-client": "*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.6.0",
    "jsonschema": "1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src testing build.mjs --deny-warnings",
    "format:check": "prettier --check src testing build.mjs package.json tsconfig.json README.md",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  }
}
