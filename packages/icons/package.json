{
  "name": "@flame/icons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "DESIGN.md"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/generated/index.d.ts",
      "import": "./dist/react/generated/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./svg/*": "./dist/svg/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "check": "npm run build && tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "preview": "npm run build && node scripts/preview.mjs"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.3.1",
    "typescript": "^7.0.2"
  }
}
