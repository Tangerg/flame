{
  "name": "@flame/backend-sdk",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.generated.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "@flame/runtime-client": "*",
    "@qimu/node": "*",
    "@qimu/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src testing --deny-warnings",
    "format:check": "prettier --check src testing package.json tsconfig.json README.md",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
