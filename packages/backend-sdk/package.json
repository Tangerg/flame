{
  "name": "@flame/backend-sdk",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.generated.json",
    "./mcp": "./src/mcp/index.ts",
    "./mcp/contract": "./src/mcp/contract.ts",
    "./mcp/callback": "./src/mcp/callback.ts",
    "./mcp/bootstrap": "./src/mcp/bootstrap.ts",
    "./build": "./build.mjs",
    "./mcp/protocol": "./src/mcp/protocol.generated.json"
  },
  "files": [
    "src",
    "README.md",
    "build.mjs"
  ],
  "dependencies": {
    "@flame/runtime-client": "*",
    "@frame/sdk": "https://github.com/Tangerg/frame/releases/download/v0.1.1/frame-sdk-0.1.1.tgz",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src testing build.mjs --deny-warnings",
    "format:check": "prettier --check src testing build.mjs package.json tsconfig.json README.md",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  }
}
