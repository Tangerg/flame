{
  "projectRoot": "/Users/dev/project",
  "projectTrusted": true,
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "shell",
      "command": "./.flame/hooks/guard.sh",
      "timeoutMillis": 5000,
      "scope": "project",
      "source": "/Users/dev/project/.flame/hooks.json",
      "active": true
    },
    {
      "event": "SessionStart",
      "inject": "You are working in the acme monorepo.",
      "scope": "global",
      "source": "/Users/dev/.flame/hooks.json",
      "active": true
    }
  ]
}
