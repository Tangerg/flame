{
  "name": "@flame/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tokens.stylex.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.stylex": {
      "types": "./dist/tokens.stylex.d.ts",
      "import": "./src/tokens.stylex.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./theme-bootstrap": {
      "types": "./dist/theme-bootstrap.d.ts",
      "import": "./dist/theme-bootstrap.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./floating-surface": {
      "types": "./dist/floating-surface.d.ts",
      "import": "./dist/floating-surface.js"
    },
    "./text-field": {
      "types": "./dist/text-field.d.ts",
      "import": "./dist/text-field.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button.d.ts",
      "import": "./dist/icon-button.js"
    },
    "./empty-state": {
      "types": "./dist/empty-state.d.ts",
      "import": "./dist/empty-state.js"
    },
    "./glyph-swap": {
      "types": "./dist/glyph-swap.d.ts",
      "import": "./dist/glyph-swap.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "import": "./dist/vocabulary.js"
    },
    "./tone-ink": {
      "types": "./dist/tone-ink.d.ts",
      "import": "./dist/tone-ink.js"
    },
    "./typography": {
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js"
    },
    "./well-surface": {
      "types": "./dist/well-surface.d.ts",
      "import": "./dist/well-surface.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./font-scale": {
      "types": "./dist/font-scale.d.ts",
      "import": "./dist/font-scale.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src scripts test --deny-warnings",
    "format:check": "prettier --check src scripts test README.md package.json tsconfig.json vitest.config.ts",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test && node --test test/package.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@stylexjs/stylex": "^0.19.1",
    "@flame/icons": "^0.1.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^26.6.5",
    "@babel/core": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@stylexjs/babel-plugin": "^0.19.1",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "happy-dom": "^21.0.1",
    "@testing-library/react": "^16.3.3",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@flame/icons": "file:../icons"
  }
}
