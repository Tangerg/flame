{
  "name": "flame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0",
    "npm": ">=11.21.1"
  },
  "workspaces": [
    "apps/web",
    "packages/runtime-client",
    "packages/component-sdk",
    "packages/backend-sdk",
    "packages/ui",
    "packages/icons",
    "plugins",
    "examples/plugins/composition",
    "examples/plugins/reviews/component",
    "qimu/sdk",
    "qimu/browser",
    "qimu/react",
    "qimu/node",
    "qimu/examples/document/web",
    "qimu/examples/authoring/browser"
  ],
  "scripts": {
    "prepare": "husky .husky",
    "check": "make check",
    "generate": "make generate",
    "lint": "oxlint tooling --deny-warnings",
    "format:check": "prettier --check tooling package.json package-lock.json README.md DEVELOPMENT.md docs .github/workflows",
    "test:tooling": "node --test tooling/*.test.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "prettier": "^3.9.10",
    "oxlint": "^1.89.0",
    "@babel/core": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "typescript": "^7.0.2",
    "rolldown": "^1.2.15"
  },
  "overrides": {
    "katex": "0.19.0",
    "uuid": "11.1.1",
    "image-size": "2.0.4"
  }
}
